<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>KGV.Maui</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Android-only MAUI app -->
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationId>de.kgv.oberrothenbach</ApplicationId>
    <ApplicationTitle>KGV</ApplicationTitle>
    <!-- Min/Target SDK -->
    <AndroidMinSdkVersion>21</AndroidMinSdkVersion>
    <AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <ApplicationDisplayVersion>0.2.18</ApplicationDisplayVersion>
    <ApplicationVersion>36</ApplicationVersion>
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <AndroidSigningKeyStore>..\_secrets\Android\kgv-upload.keystore</AndroidSigningKeyStore>
  </PropertyGroup>
  <!-- Debug stability settings -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidUseSharedRuntime>true</AndroidUseSharedRuntime>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <!-- Play Store Distribution: AAB als Release-Artefakt -->
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Play-Store-Builds verwenden keinen eigenen Update-Download-/Installationspfad. -->
    <DefineConstants>$(DefineConstants);KGV_PLAYSTORE</DefineConstants>
    <!-- Default: kein eigener Keystore. Release wird dann mit Debug-Key signiert (installierbar).
		     Ein echter Release-Keystore wird ausschlieÃƒÅ¸lich ÃƒÂ¼ber den Publish-Aufruf (z.B. `release_android.bat`) gesetzt. -->
    <AndroidKeyStore>false</AndroidKeyStore>
  </PropertyGroup>
  <!-- Ensure MSBuild can find Android SDK when building from CLI (or if VS value is empty) -->
  <PropertyGroup Condition="('$(AndroidSdkDirectory)'=='' Or !Exists('$(AndroidSdkDirectory)\platform-tools\adb.exe')) And Exists('$(LocalAppData)\Android\Sdk\platform-tools\adb.exe')">
    <AndroidSdkDirectory>$(LocalAppData)\Android\Sdk</AndroidSdkDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AndroidSdkDirectory)'!='' And ('$(AdbToolPath)'=='' Or !Exists('$(AdbToolPath)\$(AdbToolExe)'))">
    <AdbToolPath>$(AndroidSdkDirectory)\platform-tools</AdbToolPath>
    <AdbToolExe Condition="'$(AdbToolExe)'==''">adb.exe</AdbToolExe>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AndroidKeyStore>True</AndroidKeyStore>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AndroidUseAapt2>True</AndroidUseAapt2>
    <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
    <AndroidKeyStore>True</AndroidKeyStore>
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
    <AndroidUseAapt2>True</AndroidUseAapt2>
    <AndroidSigningStorePass>KGV_1234</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>kgvupload</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(AndroidSigningStorePass)</AndroidSigningKeyPass>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
    <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
    <AndroidUseAapt2>True</AndroidUseAapt2>
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidSigningStorePass>KGV_1234</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>kgvupload</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(AndroidSigningStorePass)</AndroidSigningKeyPass>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KGV.Core\KGV.Core.csproj" />
    <ProjectReference Include="..\KGV.Infrastructure\KGV.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.3" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
  </ItemGroup>
  <ItemGroup>
    <MauiAsset Include="..\appsettings.json" Link="appsettings.json" />
  </ItemGroup>
  <ItemGroup>
    <MauiSplashScreen Include="Resources\AppIcon\appicon.png" Color="#2E7D32" BaseSize="192,192" />
  </ItemGroup>
  <ItemGroup>
    <MauiImage Include="Resources\Images\*.png" />
    <MauiImage Include="Resources\Images\*.svg" />
  </ItemGroup>
  <ItemGroup>
    <AndroidResource Include="Platforms\Android\Resources\**\*.*" />
  </ItemGroup>
</Project>