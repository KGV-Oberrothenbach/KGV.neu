<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KGV.Maui.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="KGV.Maui.Pages.MemberSearchPage"
             x:DataType="viewmodels:MemberSearchViewModel"
             Title="Mitgliedersuche">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <Label Text="Mitgliedersuche" FontSize="24" FontAttributes="Bold" />

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Entry Placeholder="Suche" Text="{Binding SearchText}" />
                <Button Grid.Column="1" Text="Suchen" Command="{Binding SearchCommand}" />
            </Grid>

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding SearchByParzelle}" />
                <Label Text="nach Gartennummer suchen" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>

        <CollectionView x:Name="ResultsCollectionView"
                        Grid.Row="2"
                        ItemsSource="{Binding Results}"
                        SelectionMode="Single"
                        SelectionChanged="ResultsCollectionView_SelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:MemberSearchResultItem">
                    <Border Stroke="#E3E7EB" StrokeThickness="1" BackgroundColor="White" Padding="14" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Subtitle}" FontSize="12" Opacity="0.78" IsVisible="{Binding HasSubtitle}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End">
                                <Border StrokeThickness="0" BackgroundColor="#F1F6FA" Padding="10,4" IsVisible="{Binding HasGartenNummern}">
                                    <Label Text="{Binding GartenNummernText, StringFormat='Garten {0}'}" FontSize="12" TextColor="#446B8A" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border StrokeThickness="0" BackgroundColor="#F5F1F7" Padding="10,4" HorizontalOptions="End" IsVisible="{Binding IstHauptmitglied}">
                                    <Label Text="Hauptmitglied" FontSize="11" TextColor="#6E4D77" HorizontalTextAlignment="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" Color="#EEF1F4" IsVisible="{Binding HasGartenNummern}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView Grid.Row="3" ItemsSource="{Binding DebugMessages}" HeightRequest="120">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                    <Label Text="{Binding .}" FontSize="12" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
