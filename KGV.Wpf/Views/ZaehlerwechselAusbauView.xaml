<UserControl x:Class="KGV.Views.ZaehlerwechselAusbauView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel MaxWidth="760">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,18" />

                <Border Padding="16" Background="{StaticResource KgvSurfaceBrush}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Parzellenkontext" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ParzelleDisplayName}" Margin="0,10,0,4" FontWeight="SemiBold" />
                        <TextBlock Text="Medium" Foreground="Gray" />
                        <TextBlock Text="{Binding MediumDisplay}" Margin="0,0,0,8" />
                        <TextBlock Text="Aktiver Zähler" Foreground="Gray" />
                        <TextBlock Text="{Binding AktiverZaehlerDisplay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource KgvBackgroundBrush}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Ausbau" FontSize="18" FontWeight="SemiBold" />

                        <TextBlock Text="Ausbau-Datum" Margin="0,12,0,4" />
                        <DatePicker SelectedDate="{Binding AusbauDatum, Mode=TwoWay}" />

                        <TextBlock Text="Schlussstand" Margin="0,12,0,4" />
                        <TextBox Text="{Binding SchlussstandText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,12,0,0"
                                   Foreground="DarkSlateBlue"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="Zurück" Command="{Binding BackCommand}" Margin="0,0,10,0" MinWidth="120" />
                            <Button Content="Ausbau speichern" Command="{Binding SaveCommand}" MinWidth="160" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
