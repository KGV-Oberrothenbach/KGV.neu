<UserControl x:Class="KGV.Views.ImpressumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel MaxWidth="820">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,18" />

                <Border Padding="16" Background="{StaticResource KgvSurfaceBrush}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Verein" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Kleingartenverein Oberrothenbach e.V." Margin="0,10,0,4" FontWeight="SemiBold" />
                        <TextBlock Text="Amtsgericht Chemnitz VR 70502" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource KgvBackgroundBrush}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Vorstand" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Aktuell keine Vorstandsangaben hinterlegt."
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowVorstandFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Vorstand}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,12,0,0" Padding="12" Background="White" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Funktion}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayName}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Visibility="{Binding HasEmail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Run Text="E-Mail: " />
                                                <Run Text="{Binding Email}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,2,0,0"
                                                       Visibility="{Binding HasTelefon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Run Text="Telefon: " />
                                                <Run Text="{Binding Telefon}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource KgvBackgroundBrush}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Bauausschuss" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Aktuell keine Angaben zum Bauausschuss hinterlegt."
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowBauausschussFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Bauausschuss}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,12,0,0" Padding="12" Background="White" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Funktion}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayName}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Visibility="{Binding HasEmail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Run Text="E-Mail: " />
                                                <Run Text="{Binding Email}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,2,0,0"
                                                       Visibility="{Binding HasTelefon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Run Text="Telefon: " />
                                                <Run Text="{Binding Telefon}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
