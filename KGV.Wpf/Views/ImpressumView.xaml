<UserControl x:Class="KGV.Views.ImpressumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel MaxWidth="820">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,18" />
                <CheckBox Content="Demo-Datensätze einblenden"
                          Margin="0,0,0,16"
                          IsChecked="{Binding ShowDemoData}"
                          Visibility="{Binding IsDemoToggleVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Border Padding="16" Background="{StaticResource KgvSurfaceBrush}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Impressum" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ClubName}" Margin="0,10,0,4" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ClubRegistry}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Verantwortlich:" />
                        <TextBlock Text="{Binding ResponsibleName}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResponsibleStreet}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResponsibleCity}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="E-Mail: " />
                            <Run Text="{Binding ClubEmail, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource KgvBackgroundBrush}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Weitere Vorstandsmitglieder" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Aktuell keine Vorstandsangaben hinterlegt."
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                    Visibility="{Binding VorstandFallbackVisibility}" />
                        <ItemsControl ItemsSource="{Binding WeitereVorstandsmitglieder}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,12,0,0" Padding="12" Background="White" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding DisplayHandyText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource KgvBackgroundBrush}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Bauausschuss" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Aktuell keine Angaben zum Bauausschuss hinterlegt."
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding BauausschussFallbackVisibility}" />
                        <ItemsControl ItemsSource="{Binding Bauausschussmitglieder}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,12,0,0" Padding="12" Background="White" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding DisplayHandyText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource KgvSurfaceBrush}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Datenschutz" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DatenschutzHinweis}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <Button Content="Datenschutzerklärung öffnen"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding OpenDatenschutzCommand}" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,16,0,0"
                           Foreground="DarkSlateBlue"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Visibility="{Binding StatusVisibility}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
