<UserControl x:Class="KGV.Views.HomeSectionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock Text="{Binding SectionTitle}" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <Button Content="Zur Startseite"
                    DockPanel.Dock="Right"
                    Command="{Binding ZurueckCommand}" />
        </DockPanel>

        <Border Grid.Row="1"
                Padding="18"
                Background="{StaticResource KgvSurfaceBrush}"
                BorderBrush="{StaticResource KgvBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}"
                           Margin="0,6,0,0"
                           Foreground="Gray"
                           Visibility="{Binding HasSubtitle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding StartTimeText, StringFormat=Beginn: {0}}"
                           Margin="0,8,0,0"
                           Foreground="Gray"
                           Visibility="{Binding HasStartTimeText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding EndTimeText, StringFormat=Ende: {0}}"
                           Margin="0,4,0,0"
                           Foreground="Gray"
                           Visibility="{Binding HasEndTimeText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border Margin="0,16,0,0"
                        Padding="12"
                        Background="{StaticResource KgvBackgroundBrush}"
                        CornerRadius="12"
                        Visibility="{Binding HasRegistrationInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding RegistrationInfo}" TextWrapping="Wrap" Foreground="DarkSlateBlue" />
                </Border>
                <Button Content="Anmelden"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding AnmeldenCommand}"
                        Visibility="{Binding ShowRegisterButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border Margin="0,16,0,0"
                        Padding="12"
                        Background="{StaticResource KgvBackgroundBrush}"
                        CornerRadius="12"
                        Visibility="{Binding ShowParticipantsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Angemeldete Teilnehmer" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <Button Content="Hinzufügen"
                                    DockPanel.Dock="Right"
                                    Command="{Binding AddParticipantCommand}" />
                        </DockPanel>
                        <ItemsControl Margin="0,12,0,0"
                                      ItemsSource="{Binding Participants}"
                                      Visibility="{Binding HasParticipants, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="Gray" FontSize="11" />
                                        </StackPanel>
                                        <Button Content="Abmelden"
                                                Margin="12,0,0,0"
                                                DockPanel.Dock="Right"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveParticipantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ParticipantsEmptyText}"
                                   Margin="0,12,0,0"
                                   Foreground="Gray"
                                   Visibility="{Binding ShowParticipantsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,16,0,0"
                        Padding="12"
                        Background="{StaticResource KgvBackgroundBrush}"
                        CornerRadius="12"
                        Visibility="{Binding HasAdditionalInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding AdditionalInfo}" TextWrapping="Wrap" Foreground="DarkSlateBlue" />
                </Border>
                <ScrollViewer Margin="0,16,0,0"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
