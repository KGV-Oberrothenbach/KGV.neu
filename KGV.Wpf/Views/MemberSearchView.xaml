<UserControl x:Class="KGV.Views.MemberSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:KGV.Helpers"
             Background="{DynamicResource KgvBackgroundBrush}">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverterLocal x:Key="BoolToVisibilityConverterLocal"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding ViewTitle}" FontSize="18" FontWeight="Bold" />

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,8,0,8">
            <TextBox Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Suchen" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
            <CheckBox Content="nach Gartennummer suchen"
                      Margin="12,0,0,0"
                      IsChecked="{Binding SearchByParzelle}" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <ListView x:Name="ResultsListView"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedResult}"
                      Height="300"
                      MouseDoubleClick="ResultsListView_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn>
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Name" Click="GridViewColumnHeader_Click" Tag="Nachname" />
                            </GridViewColumn.Header>
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="Nachname" />
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>

                        <GridViewColumn>
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Vorname" Click="GridViewColumnHeader_Click" Tag="Vorname" />
                            </GridViewColumn.Header>
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="Vorname" />
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>

                        <GridViewColumn>
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="E-Mail" Click="GridViewColumnHeader_Click" Tag="Email" />
                            </GridViewColumn.Header>
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="Email" />
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>

                        <GridViewColumn>
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Gartennummern" Click="GridViewColumnHeader_Click" Tag="GartenNummernText" />
                            </GridViewColumn.Header>
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="GartenNummernText" />
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>

                        <GridViewColumn>
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Hauptmitglied" Click="GridViewColumnHeader_Click" Tag="IstHauptmitglied" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IstHauptmitglied}"
                                              HorizontalAlignment="Center"
                                              IsEnabled="False" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <!-- ⚡ Debug-Output -->
        <ListBox Grid.Row="3"
                 ItemsSource="{Binding DebugMessages}"
                 Height="100"
                 Background="#f0f0f0"/>
    </Grid>
</UserControl>