<UserControl x:Class="KGV.Views.ArbeitseinsaetzeVerwaltungEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ValidationTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource KgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="BorderBrush" Value="IndianRed" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValidationDatePickerStyle" TargetType="DatePicker">
            <Setter Property="BorderBrush" Value="{StaticResource KgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="BorderBrush" Value="IndianRed" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Aktualisieren" Margin="0,0,10,0" Command="{Binding AktualisierenCommand}" />
                <Button Content="Öffnen" Margin="0,0,10,0" Command="{Binding OeffnenCommand}" />
                <Button Content="Neu" Command="{Binding NeuCommand}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.55*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Vorhandene Arbeitseinsätze" Margin="0,0,12,0">
                <Grid Margin="8">
                    <ListBox ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             BorderThickness="0"
                             Visibility="{Binding HasEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OeffnenCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        Background="{StaticResource KgvBackgroundBrush}"
                                        BorderBrush="{StaticResource KgvBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titel}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Datum, StringFormat={}{0:dd.MM.yyyy}}" Margin="0,4,0,0" Foreground="Gray" />
                                        <TextBlock Margin="0,4,0,0" Foreground="Gray">
                                            <Run Text="Treffpunkt: " />
                                            <Run Text="{Binding Treffpunkt}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,0" Foreground="Gray">
                                            <Run Text="Teilnehmer: " />
                                            <Run Text="{Binding MaxTeilnehmer}" />
                                            <Run Text="  Stundenwert: " />
                                            <Run Text="{Binding StundenWert}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding EmptyText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </GroupBox>

            <Border Grid.Column="1"
                    Padding="18"
                    Background="{StaticResource KgvSurfaceBrush}"
                    BorderBrush="{StaticResource KgvBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorCaption}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Margin="0,12,0,0"
                                   Foreground="IndianRed"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ValidationHintText}" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray" />

                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Titel *" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     x:Name="TitelTextBox"
                                     Style="{StaticResource ValidationTextBoxStyle}"
                                     Tag="{Binding IsTitelInvalid}"
                                     Text="{Binding Titel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Beschreibung" VerticalAlignment="Top" Margin="0,12,12,0" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,12,0,0"
                                     Height="100"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     Text="{Binding Beschreibung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Datum *" VerticalAlignment="Center" Margin="0,12,12,0" />
                            <DatePicker Grid.Row="2"
                                        Grid.Column="1"
                                        x:Name="DatumPicker"
                                        Margin="0,12,0,0"
                                        Style="{StaticResource ValidationDatePickerStyle}"
                                        Tag="{Binding IsDatumInvalid}"
                                        SelectedDate="{Binding Datum, Mode=TwoWay}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Startuhrzeit" VerticalAlignment="Center" Margin="0,12,12,0" />
                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     x:Name="StartUhrzeitTextBox"
                                     Margin="0,12,0,0"
                                     Style="{StaticResource ValidationTextBoxStyle}"
                                     Tag="{Binding IsStartUhrzeitInvalid}"
                                     Text="{Binding StartUhrzeitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Enduhrzeit" VerticalAlignment="Center" Margin="0,12,12,0" />
                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     x:Name="EndUhrzeitTextBox"
                                     Margin="0,12,0,0"
                                     Style="{StaticResource ValidationTextBoxStyle}"
                                     Tag="{Binding IsEndUhrzeitInvalid}"
                                     Text="{Binding EndUhrzeitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Treffpunkt" VerticalAlignment="Center" Margin="0,12,12,0" />
                            <TextBox Grid.Row="5"
                                     Grid.Column="1"
                                     Margin="0,12,0,0"
                                     Text="{Binding Treffpunkt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Teilnehmerbegrenzung" VerticalAlignment="Top" Margin="0,12,12,0" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,12,0,0">
                                <CheckBox Content="Begrenzung aktiv"
                                          IsChecked="{Binding HasTeilnehmerbegrenzung, Mode=TwoWay}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="Gray"
                                           Text="Ohne Begrenzung"
                                           Visibility="{Binding ShowUnbegrenztHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBox x:Name="MaxTeilnehmerTextBox"
                                         Margin="0,8,0,0"
                                         Style="{StaticResource ValidationTextBoxStyle}"
                                         Tag="{Binding IsMaxTeilnehmerInvalid}"
                                         Text="{Binding MaxTeilnehmerText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding ShowMaxTeilnehmerInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Stundenwert" VerticalAlignment="Center" Margin="0,12,12,0" />
                            <TextBox Grid.Row="7"
                                     Grid.Column="1"
                                     x:Name="StundenWertTextBox"
                                     Margin="0,12,0,0"
                                     Style="{StaticResource ValidationTextBoxStyle}"
                                     Tag="{Binding IsStundenWertInvalid}"
                                     Text="{Binding StundenWertText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Sichtbar ab" VerticalAlignment="Top" Margin="0,12,12,0" />
                            <Grid Grid.Row="8" Grid.Column="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0"
                                            x:Name="SichtbarAbDatePicker"
                                            Style="{StaticResource ValidationDatePickerStyle}"
                                            Tag="{Binding IsSichtbarAbInvalid}"
                                            SelectedDate="{Binding SichtbarAbDatum, Mode=TwoWay}" />
                                <TextBox Grid.Column="1"
                                         Margin="12,0,0,0"
                                         Style="{StaticResource ValidationTextBoxStyle}"
                                         Tag="{Binding IsSichtbarAbInvalid}"
                                         Text="{Binding SichtbarAbZeitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Sichtbar bis" VerticalAlignment="Top" Margin="0,12,12,0" />
                            <Grid Grid.Row="9" Grid.Column="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0"
                                            x:Name="SichtbarBisDatePicker"
                                            Style="{StaticResource ValidationDatePickerStyle}"
                                            Tag="{Binding IsSichtbarBisInvalid}"
                                            SelectedDate="{Binding SichtbarBisDatum, Mode=TwoWay}" />
                                <TextBox Grid.Column="1"
                                         Margin="12,0,0,0"
                                         Style="{StaticResource ValidationTextBoxStyle}"
                                         Tag="{Binding IsSichtbarBisInvalid}"
                                         Text="{Binding SichtbarBisZeitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Anmeldung bis" VerticalAlignment="Top" Margin="0,12,12,0" />
                            <Grid Grid.Row="10" Grid.Column="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0"
                                            x:Name="AnmeldungBisDatePicker"
                                            Style="{StaticResource ValidationDatePickerStyle}"
                                            Tag="{Binding IsAnmeldungBisInvalid}"
                                            SelectedDate="{Binding AnmeldungBisDatum, Mode=TwoWay}" />
                                <TextBox Grid.Column="1"
                                         Margin="12,0,0,0"
                                         Style="{StaticResource ValidationTextBoxStyle}"
                                         Tag="{Binding IsAnmeldungBisInvalid}"
                                         Text="{Binding AnmeldungBisZeitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Grid>

                        <CheckBox Margin="0,16,0,0"
                                  Content="Aktiv"
                                  IsChecked="{Binding Aktiv, Mode=TwoWay}" />

                        <Border Margin="0,16,0,0" Padding="12" Background="{StaticResource KgvBackgroundBrush}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="{Binding ReadPathText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WritePathText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,18,0,0" LastChildFill="False">
                            <Button Content="Abbrechen"
                                    Width="110"
                                    DockPanel.Dock="Right"
                                    Margin="0,0,10,0"
                                    Command="{Binding AbbrechenCommand}" />
                            <Button Content="Speichern"
                                    Width="110"
                                    DockPanel.Dock="Right"
                                    Command="{Binding SpeichernCommand}" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
