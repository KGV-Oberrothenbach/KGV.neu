<UserControl x:Class="KGV.Views.AdminRoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource KgvBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="Admin-Menü" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left" />
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="0,15,0,0">
            <Run Text="Mitglied: " />
            <Run Text="{Binding SelectedMember.Nachname}" FontWeight="SemiBold" />
            <Run Text=" " />
            <Run Text="{Binding SelectedMember.Vorname}" FontWeight="SemiBold" />
            <Run Text=" (ID: " />
            <Run Text="{Binding SelectedMember.Id}" />
            <Run Text=")" />
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
            <TextBlock Text="Rolle:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Width="200"
                      ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      IsEnabled="{Binding CanEditRole}" />
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="DarkRed" FontWeight="SemiBold">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRoleEditable}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            Rollenbearbeitung für dieses Mitglied ist gesperrt.
        </TextBlock>

        <TextBlock Grid.Row="3"
                   Margin="0,34,0,0"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Text="{Binding RoleManagementHint, Mode=OneWay}" />

        <StackPanel Grid.Row="4" Margin="0,20,0,0">
            <TextBlock Text="Benutzerverwaltung" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Button Content="Benutzerverwaltung öffnen"
                    Width="220"
                    Height="35"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenUserManagementCommand}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanOpenUserManagement}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,20,0,0">
            <TextBlock Text="Zählerablesungen" FontWeight="SemiBold" Margin="0,0,0,8" />
            <CheckBox Content="Normale Nutzer dürfen eigene Zählerablesungen einreichen"
                      IsChecked="{Binding AllowUserMeterReadingSubmissions}"
                      IsEnabled="{Binding CanManageUserMeterReadingSubmissions}" />
            <TextBlock Margin="24,6,0,0"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Text="Der Schalter legt zentral fest, ob eigene Nutzerablesungen außerhalb der direkten Freigabepfade eingereicht werden dürfen." />
        </StackPanel>

            <Border Grid.Row="6"
                    Margin="0,24,0,0"
                    Padding="16"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Globale Fachrechte" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                        <Run Text="Rollenbasis: " />
                        <Run Text="{Binding PermissionRoleBasis, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="App-User: " />
                        <Run Text="nicht verknüpft" FontWeight="SemiBold">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Setter Property="Text" Value="nicht verknüpft" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLinkedAppUser}" Value="True">
                                            <Setter Property="Text" Value="verknüpft" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{Binding PermissionSaveHint, Mode=OneWay}" />

                    <Button Margin="0,12,0,0"
                            Width="260"
                            Height="35"
                            HorizontalAlignment="Left"
                            Content="Alles auf Rollen-Standard zurücksetzen"
                            Command="{Binding ResetPermissionOverridesCommand}" />

                    <ScrollViewer Margin="0,12,0,0"
                                  MaxHeight="360"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Fachbereich" FontWeight="SemiBold" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="Rollenbasis" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="2" Text="Aus" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="3" Text="Lesen" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="4" Text="Bearbeiten" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding PermissionOverrides}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"
                                                       Text="{Binding DisplayName, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,12,0"
                                                       Text="{Binding BaseLevelDisplay, Mode=OneWay}" />
                                            <CheckBox Grid.Column="2"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      IsChecked="{Binding IsNoneSelected}"
                                                      IsEnabled="{Binding IsEditable}" />
                                            <CheckBox Grid.Column="3"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      IsChecked="{Binding IsReadSelected}"
                                                      IsEnabled="{Binding IsEditable}" />
                                            <CheckBox Grid.Column="4"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsWriteSelected}"
                                                      IsEnabled="{Binding IsEditable}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
                        <Run Text="Aktueller Override-Zustand: " />
                        <Run Text="{Binding CurrentOverrideState, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="Wirksame Rechte: " />
                        <Run Text="{Binding EffectivePermissionState, Mode=OneWay}" />
                    </TextBlock>

                    <Button Margin="0,16,0,0"
                            Width="220"
                            Height="35"
                            HorizontalAlignment="Left"
                            Content="Fachrechte speichern"
                            Command="{Binding SavePermissionOverridesCommand}" />
                </StackPanel>
            </Border>

        <Button Grid.Row="7"
                Margin="0,20,0,0"
                Width="220"
                Height="35"
                HorizontalAlignment="Left"
                Content="Speichern"
                Command="{Binding SaveCommand}" />
        </Grid>
    </ScrollViewer>
</UserControl>
