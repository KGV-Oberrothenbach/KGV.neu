<UserControl x:Class="KGV.Views.AblesungenFreigabeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <Button Content="Aktualisieren"
                    Width="130"
                    DockPanel.Dock="Right"
                    Command="{Binding AktualisierenCommand}" />
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}"
                       Margin="0,10,0,0"
                       Foreground="DarkSlateBlue"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    Background="{StaticResource KgvSurfaceBrush}"
                    BorderBrush="{StaticResource KgvBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Offene Einreichungen"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding EmptyText}"
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <DataGrid ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Parzelle" Binding="{Binding ParzelleDisplayName}" Width="*" />
                                <DataGridTextColumn Header="Medium" Binding="{Binding MediumDisplay}" Width="90" />
                                <DataGridTextColumn Header="Datum" Binding="{Binding Ablesedatum, StringFormat={}{0:dd.MM.yyyy}}" Width="110" />
                                <DataGridTextColumn Header="Stand" Binding="{Binding Stand, StringFormat={}{0:0.##}}" Width="100" />
                                <DataGridTextColumn Header="Mitglied / Quelle" Binding="{Binding MitgliedDisplay}" Width="*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding PruefstatusDisplay}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    Background="{StaticResource KgvSurfaceBrush}"
                    BorderBrush="{StaticResource KgvBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="Prüfung" FontWeight="SemiBold" />
                    <TextBlock Text="Die Entscheidung wird direkt über den gemeinsamen Prüfstatuspfad gespeichert."
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="Gray" />

                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Parzelle" FontWeight="SemiBold" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.ParzelleDisplayName}" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Medium" FontWeight="SemiBold" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.MediumDisplay}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Zähler" FontWeight="SemiBold" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.Zaehlernummer}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Datum" FontWeight="SemiBold" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.Ablesedatum, StringFormat={}{0:dd.MM.yyyy}}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Zählerstand" FontWeight="SemiBold" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Stand, StringFormat={}{0:0.##}}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Mitglied / Quelle" FontWeight="SemiBold" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.MitgliedDisplay}" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="Prüfkommentar"
                                   Margin="0,16,0,6"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Kommentar ist für Freigeben, Ablehnen, Korrigieren und Entfernen verpflichtend. Korrigieren speichert Datum und Zählerstand direkt als freigegeben; Entfernen markiert die Einreichung mit Begründung als abgelehnt und nimmt sie damit aus dem offenen Prüfprozess heraus."
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   Margin="0,0,0,8" />
                        <TextBox Text="{Binding ReviewComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="100" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Korrekturdatum" FontWeight="SemiBold" Margin="0,0,12,8" />
                            <DatePicker Grid.Row="0"
                                        Grid.Column="1"
                                        SelectedDate="{Binding EditAblesedatum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Korrigierter Stand" FontWeight="SemiBold" Margin="0,0,12,0" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding EditStandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Freigeben"
                                    Width="130"
                                    Margin="0,0,12,0"
                                    Command="{Binding FreigebenCommand}" />
                            <Button Content="Ablehnen"
                                    Width="130"
                                    Margin="0,0,12,0"
                                    Command="{Binding AblehnenCommand}" />
                            <Button Content="Korrigieren"
                                    Width="130"
                                    Margin="0,0,12,0"
                                    Command="{Binding KorrigierenCommand}" />
                            <Button Content="Entfernen"
                                    Width="130"
                                    Command="{Binding LoeschenCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
