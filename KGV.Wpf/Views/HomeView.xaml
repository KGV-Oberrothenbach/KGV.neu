<UserControl x:Class="KGV.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,8" />

            <Border Padding="16"
                    Background="{StaticResource KgvSurfaceBrush}"
                    BorderBrush="{StaticResource KgvBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="{Binding ShowAdminManagementSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Verwaltung" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Bearbeitung wird bewusst über separate Verwaltungsviews geöffnet; Home bleibt reine Übersicht." Margin="0,8,0,12" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Content="Arbeitseinsätze bearbeiten" Margin="0,0,12,12" Command="{Binding OpenWorkAssignmentsManagementCommand}" />
                        <Button Content="Termine bearbeiten" Margin="0,0,12,12" Command="{Binding OpenAppointmentsManagementCommand}" />
                        <Button Content="Bekanntmachungen bearbeiten" Margin="0,0,12,12" Command="{Binding OpenAnnouncementsManagementCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Padding="18"
                Background="{StaticResource KgvSurfaceBrush}"
                BorderBrush="{StaticResource KgvBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <StackPanel>
                <TextBlock Text="{Binding WorkHoursHeader}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,12,0" Padding="12" Background="{StaticResource KgvBackgroundBrush}" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Sollstunden" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RequiredHoursValue}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <TextBlock Text="{Binding RequiredHoursHint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="0,0,12,0" Padding="12" Background="{StaticResource KgvBackgroundBrush}" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Geleistete Stunden" FontWeight="SemiBold" />
                            <Button Command="{Binding OpenWorkedHoursCommand}"
                                    Margin="0,8,0,4"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Left">
                                <TextBlock Text="{Binding WorkedHoursValue}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           TextDecorations="Underline" />
                            </Button>
                            <TextBlock Text="{Binding WorkedHoursHint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="12" Background="{StaticResource KgvBackgroundBrush}" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Offene Stunden" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OpenHoursValue}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <TextBlock Text="{Binding OpenHoursHint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding WorkHoursInfoText}" TextWrapping="Wrap" />

                <Button Content="Arbeitsstunden erfassen"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenWorkHoursEntryCommand}"
                        Visibility="{Binding CanOpenWorkHoursEntry, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Arbeitseinsätze" Margin="0,0,12,0">
                <StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasWorkAssignments, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding WorkAssignments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="12"
                                            Background="{StaticResource KgvBackgroundBrush}"
                                            BorderBrush="{StaticResource KgvBorderBrush}"
                                            BorderThickness="1">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenWorkAssignmentDetailCommand, RelativeSource={RelativeSource AncestorType=GroupBox}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" Foreground="Gray" />
                                            <TextBlock Text="{Binding TimeText, StringFormat=Uhrzeit: {0}}"
                                                       Margin="0,4,0,0"
                                                       Foreground="Gray"
                                                       Visibility="{Binding HasTimeText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding RegistrationInfo}"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="DarkSlateBlue"
                                                       Visibility="{Binding HasRegistrationInfo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="Anmelden"
                                                        Command="{Binding DataContext.RegisterForWorkAssignmentCommand, RelativeSource={RelativeSource AncestorType=GroupBox}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanRegister, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding WorkAssignmentsEmptyText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowWorkAssignmentsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Termine" Margin="0,0,12,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Appointments}"
                                  Visibility="{Binding HasAppointments, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{StaticResource KgvBackgroundBrush}"
                                        BorderBrush="{StaticResource KgvBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.OpenAppointmentDetailCommand, RelativeSource={RelativeSource AncestorType=GroupBox}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="Gray" />
                                        <TextBlock Text="{Binding TimeText, StringFormat=Uhrzeit: {0}}"
                                                   Margin="0,4,0,0"
                                                   Foreground="Gray"
                                                   Visibility="{Binding HasTimeText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding AppointmentsEmptyText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowAppointmentEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Bekanntmachungen">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Announcements}"
                                  Visibility="{Binding HasAnnouncements, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{StaticResource KgvBackgroundBrush}"
                                        BorderBrush="{StaticResource KgvBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.OpenAnnouncementDetailCommand, RelativeSource={RelativeSource AncestorType=GroupBox}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="Gray" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding AnnouncementEmptyText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowAnnouncementEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
