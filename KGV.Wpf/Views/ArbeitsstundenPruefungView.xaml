<UserControl x:Class="KGV.Views.ArbeitsstundenPruefungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CommentTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource KgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="BorderBrush" Value="IndianRed" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <Button Content="Aktualisieren"
                    DockPanel.Dock="Right"
                    Width="120"
                    Command="{Binding AktualisierenCommand}" />
        </DockPanel>

        <Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,12"
                Background="{StaticResource KgvBackgroundBrush}"
                CornerRadius="12"
                Visibility="{Binding ShowLockMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding LockMessage}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding StatusMessage}"
                       Margin="0,0,0,12"
                       Foreground="DarkSlateBlue"
                       TextWrapping="Wrap"
                       Visibility="{Binding ShowStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1.8*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding OffenePruefungen}"
                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Margin="0,0,0,12"
                              Visibility="{Binding ShowTable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mitglied" Binding="{Binding MitgliedDisplayName}" Width="180" IsReadOnly="True" />
                            <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat={}{0:dd.MM.yyyy}}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Saison" Binding="{Binding SaisonJahr}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Stunden" Binding="{Binding Stunden, StringFormat={}{0:0.##}}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="Art der Arbeit" Binding="{Binding ArtDerArbeit}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Status" Binding="{Binding PruefstatusDisplay}" Width="120" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding EmptyText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <Border Grid.Column="2"
                        Padding="16"
                        Background="{StaticResource KgvSurfaceBrush}"
                        BorderBrush="{StaticResource KgvBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Visibility="{Binding ShowActionPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Prüfkontext" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedEntry.MitgliedDisplayName}" FontWeight="Bold" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding SelectedEntry.FreigabeInfo}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                            <TextBlock Text="Prüfkommentar *" FontWeight="Bold" />
                            <TextBox Text="{Binding ReviewComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CommentTextBoxStyle}"
                                     Tag="{Binding IsReviewCommentInvalid}"
                                     Margin="0,8,0,0"
                                     Height="90"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap" />
                            <TextBlock Text="Alle vier Aktionen verwenden denselben Pflichtkommentar. Doppelerfassungen bleiben nachvollziehbar über den Löschpfad im Prüfprozess behandelbar."
                                       Margin="0,8,0,0"
                                       Foreground="Gray"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                            <TextBlock Text="Korrektur" FontSize="16" FontWeight="SemiBold" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Datum" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding CorrectionDate, Mode=TwoWay}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Stunden" VerticalAlignment="Center" Margin="0,12,12,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"
                                         Text="{Binding CorrectionHoursText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Art der Arbeit" VerticalAlignment="Top" Margin="0,12,12,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"
                                         Height="72"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         Text="{Binding CorrectionWorkType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <UniformGrid Columns="2" Margin="0,16,0,0">
                                <Button Content="Freigeben"
                                        Margin="0,0,8,8"
                                        Command="{Binding FreigebenCommand}" />
                                <Button Content="Ablehnen"
                                        Margin="8,0,0,8"
                                        Command="{Binding AblehnenCommand}" />
                                <Button Content="Korrigieren"
                                        Margin="0,0,8,0"
                                        Command="{Binding KorrigierenCommand}" />
                                <Button Content="Löschen"
                                        Margin="8,0,0,0"
                                        Command="{Binding LoeschenCommand}" />
                            </UniformGrid>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,18,0,0">
                            <TextBlock Text="Verlauf" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Verlauf wird geladen..."
                                       Margin="0,8,0,0"
                                       Foreground="Gray"
                                       Visibility="{Binding ShowHistoryLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Zu diesem Prüffall liegt noch kein Verlauf vor."
                                       Margin="0,8,0,0"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ShowHistoryEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Margin="0,8,0,0"
                                          Visibility="{Binding ShowHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding Verlauf}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10"
                                                    Padding="10"
                                                    Background="{StaticResource KgvBackgroundBrush}"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock FontWeight="Bold"
                                                               Text="{Binding AktionDisplay}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="Gray"
                                                               Text="{Binding GeprueftAm, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                                                    <TextBlock Text="{Binding GeprueftVonName}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               FontWeight="SemiBold"
                                                               Text="Kommentar" />
                                                    <TextBlock Text="{Binding Kommentar}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               FontWeight="SemiBold"
                                                               Text="Vorher" />
                                                    <TextBlock Text="{Binding VorherSummary}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               FontWeight="SemiBold"
                                                               Text="Nachher" />
                                                    <TextBlock Text="{Binding NachherSummary, TargetNullValue=-}" 
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Text="Nur der vorhandene Prüfservice wird verwendet: Freigeben, Ablehnen, Korrigieren und Löschen laufen ohne Parallelpfad und bleiben über den Verlauf nachvollziehbar."
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
