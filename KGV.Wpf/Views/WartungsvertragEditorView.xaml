<UserControl x:Class="KGV.Views.WartungsvertragEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,18" />

                <Border Padding="16"
                        Background="{StaticResource KgvSurfaceBrush}"
                        BorderBrush="{StaticResource KgvBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="DarkSlateBlue" />

                        <TextBlock Text="Titel" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Titel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

                        <TextBlock Text="Beschreibung" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Beschreibung, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12"
                                 Height="120"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap" />

                        <TextBlock Text="Max. Kontingent" FontWeight="SemiBold" />
                        <TextBox Text="{Binding MaxKontingentText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

                        <CheckBox Content="Aktiv"
                                  IsChecked="{Binding Aktiv}"
                                  Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="120"
                                    Margin="0,0,12,0"
                                    Content="Abbrechen"
                                    Command="{Binding CancelCommand}" />
                            <Button Width="140"
                                    Content="Speichern"
                                    Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
