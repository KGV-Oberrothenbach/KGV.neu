<UserControl x:Class="KGV.Views.ZaehlerwechselScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel MaxWidth="920">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,18" />

                <Border Padding="16" Background="{StaticResource KgvSurfaceBrush}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Parzelle suchen" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Gartennummer oder Parzellenbezeichnung eingeben und danach die gewünschte Parzelle auswählen." Margin="0,6,0,12" TextWrapping="Wrap" Foreground="Gray" />

                        <DockPanel Margin="0,0,0,12">
                            <Button Content="Liste aktualisieren"
                                    Command="{Binding RefreshCommand}"
                                    Padding="16,6"
                                    DockPanel.Dock="Right" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,12,0"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>

                        <ListBox ItemsSource="{Binding FilteredParzellen}"
                                 SelectedItem="{Binding SelectedParzelle, Mode=TwoWay}"
                                 DisplayMemberPath="DisplayName"
                                 MinHeight="180" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,12,0,0"
                           Foreground="DarkSlateBlue"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Margin="0,16,0,0"
                        Padding="16"
                        Background="{StaticResource KgvBackgroundBrush}"
                        CornerRadius="12"
                        Visibility="{Binding HasSelectedDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedParzelleDisplayName}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Der geladene Korrekturzustand zeigt pro Medium, ob ein aktiver Zähler vorhanden ist oder der Einbaupfad geöffnet werden muss."
                                   Margin="0,6,0,16"
                                   TextWrapping="Wrap"
                                   Foreground="Gray" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Padding="14" Background="White" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Strom" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StromStatusText}" Margin="0,8,0,16" TextWrapping="Wrap" />
                                    <Button Content="{Binding StromActionText}"
                                            Command="{Binding OpenStromPathCommand}"
                                            HorizontalAlignment="Left"
                                            Padding="16,8"
                                            IsEnabled="{Binding CanOpenStromPath}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Padding="14" Background="White" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Wasser" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WasserStatusText}" Margin="0,8,0,16" TextWrapping="Wrap" />
                                    <Button Content="{Binding WasserActionText}"
                                            Command="{Binding OpenWasserPathCommand}"
                                            HorizontalAlignment="Left"
                                            Padding="16,8"
                                            IsEnabled="{Binding CanOpenWasserPath}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="14"
                        Background="{StaticResource KgvBackgroundBrush}"
                        CornerRadius="12"
                        Visibility="{Binding ShowSelectionHint, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Der WPF-Zählerwechsel arbeitet hier bewusst als Korrektur- und Verwaltungsweg über Garten/Parzelle. Nach Auswahl der Parzelle werden Strom- und Wasserzustand geladen und die passenden Korrekturpfade geöffnet."
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
