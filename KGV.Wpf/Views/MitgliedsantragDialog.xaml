<Window x:Class="KGV.Views.MitgliedsantragDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Title="Mitgliedsantrag erstellen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="BeschreibungTextBlock" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Beginn:" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BeginnTextBlock" VerticalAlignment="Center" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Jahresbeitrag:" VerticalAlignment="Center" Margin="0,10,10,0" />
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="JahresbeitragTextBlock" VerticalAlignment="Center" Margin="0,10,0,0" />

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" x:Name="HinweisTextBlock" TextWrapping="Wrap" Margin="0,12,0,0" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Mitgliedsbeitrag:" VerticalAlignment="Center" Margin="0,14,10,0" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="MitgliedsbeitragTextBox" Margin="0,14,0,0" />

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="100" Margin="0,0,10,0" Content="Abbrechen" IsCancel="True" />
            <Button Width="120" Content="Erzeugen" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
