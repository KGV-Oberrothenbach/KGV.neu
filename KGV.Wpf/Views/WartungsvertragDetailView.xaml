<UserControl x:Class="KGV.Views.WartungsvertragDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,18" />

                <Border Padding="16"
                        Background="{StaticResource KgvSurfaceBrush}"
                        BorderBrush="{StaticResource KgvBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Width="120"
                                    Margin="0,0,12,0"
                                    Content="Zurück"
                                    Command="{Binding BackCommand}"
                                    Visibility="{Binding HasBackTarget, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Width="130"
                                    Margin="0,0,12,0"
                                    Content="Aktualisieren"
                                    Command="{Binding RefreshCommand}" />
                            <Button Width="120"
                                    Margin="0,0,12,0"
                                    Content="Bearbeiten"
                                    Command="{Binding EditCommand}"
                                    Visibility="{Binding CanManageGlobally, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Width="160"
                                    Content="Mitglieder zuweisen"
                                    Command="{Binding AssignMembersCommand}"
                                    Visibility="{Binding CanManageGlobally, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="DarkSlateBlue" />

                        <StackPanel Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Detail.Titel}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail.BeschreibungText}" Margin="0,8,0,16" TextWrapping="Wrap" />

                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Max. Kontingent" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail.MaxKontingent}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Belegt" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail.Belegt}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Frei" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail.Frei}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Status" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail.AktivText}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Aktive Zuordnungen" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding EmptyMembersMessage}"
                                       Margin="0,0,0,8"
                                       Foreground="Gray">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAssignedMembers}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding Detail.ZugeordneteMitglieder}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      Visibility="{Binding HasAssignedMembers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mitglied" Binding="{Binding DisplayName}" Width="2*" />
                                    <DataGridTextColumn Header="Gartennummern" Binding="{Binding GartenNummern}" Width="*" />
                                    <DataGridTextColumn Header="Gültig ab" Binding="{Binding GueltigAb, StringFormat=dd.MM.yyyy}" Width="Auto" />
                                    <DataGridTextColumn Header="Gültig bis" Binding="{Binding GueltigBis, StringFormat=dd.MM.yyyy}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
