<UserControl x:Class="KGV.Views.WartungsvertragMitgliederZuordnungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,18" />

                <Border Padding="16"
                        Background="{StaticResource KgvSurfaceBrush}"
                        BorderBrush="{StaticResource KgvBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="{Binding VertragTitel}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FreiePlaetzeText}" Margin="0,4,0,8" Foreground="DarkSlateBlue" />
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="DarkSlateBlue" />

                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Sortierung" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding SortOptions}"
                                          SelectedItem="{Binding SelectedSortOption}"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Gültig ab" FontWeight="SemiBold" />
                                <DatePicker SelectedDate="{Binding GueltigAb}" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>

                        <DataGrid ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Auswahl" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanSelect}"
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Mitglied" Binding="{Binding DisplayName}" Width="2*" />
                                <DataGridTextColumn Header="Gartennummern" Binding="{Binding GartenNummern}" Width="*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Width="120"
                                    Margin="0,0,12,0"
                                    Content="Abbrechen"
                                    Command="{Binding CancelCommand}" />
                            <Button Width="160"
                                    Content="Zuordnungen speichern"
                                    Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
