<Window x:Class="KGV.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KGV.Helpers"
        xmlns:vm="clr-namespace:KGV.ViewModels"
        Title="Login" Width="460" SizeToContent="Height" MinHeight="360"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="LoginActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="LoginPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PasswordAssistButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource KgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Anmeldung" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBox Margin="0,0,0,10"
                     local:WatermarkHelper.Watermark="E-Mail"
                     Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Visibility="{Binding IsNormalLoginVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,0,0,10">
                    <PasswordBox x:Name="PasswordBox"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Width="Auto" Height="30" />
                    <TextBox x:Name="PasswordTextBox"
                             TextChanged="PasswordTextBox_TextChanged"
                             Visibility="Collapsed"
                             Width="Auto" Height="30" />
                    <Button Content="👁"
                            Width="30" Height="30"
                            HorizontalAlignment="Right"
                            Style="{StaticResource IconButton}"
                            Click="TogglePasswordVisibility_Click"/>
                </Grid>

                <Button Content="Anmelden"
                        Height="38"
                        Margin="0,0,0,8"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}" />

                <Button Content="Einladung / Erstlogin-Code anfordern"
                        Height="39"
                        Margin="0,0,0,8"
                        Command="{Binding RequestOtpCommand}" />

                <Button Content="Passwort vergessen"
                        Height="39"
                        Margin="0,0,0,8"
                        Click="OpenResetPassword_Click" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsOtpEntryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Erstlogin / OTP-Code bestätigen" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="OTP-Code" Margin="0,0,0,6"/>
                <TextBox Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Code prüfen"
                            Width="140"
                            Height="37"
                            Margin="0,0,8,0"
                            Command="{Binding VerifyOtpCommand}" />
                    <Button Content="Zurück zum Login"
                            Height="37"
                            Command="{Binding CancelOtpFlowCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding IsSetPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Neues Passwort direkt setzen" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Neues Passwort" Margin="0,0,0,6"/>
                <PasswordBox x:Name="NewPasswordBox" PasswordChanged="NewPasswordBox_PasswordChanged" Margin="0,0,0,8" />
                <TextBlock Text="Passwort wiederholen" Margin="0,0,0,6"/>
                <PasswordBox x:Name="NewPasswordConfirmBox" PasswordChanged="NewPasswordConfirmBox_PasswordChanged" Margin="0,0,0,8" />

                <Border Background="{StaticResource KgvSurfaceBrush}" BorderBrush="{StaticResource KgvBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Passwortbedingungen" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding MinimumPasswordRequirementText}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding UpperLowerPasswordRequirementText}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding DigitPasswordRequirementText}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SpecialPasswordRequirementText}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding ConfirmationRequirementText}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Neues Passwort setzen"
                            Style="{StaticResource LoginPrimaryButton}"
                            Margin="0,0,8,0"
                            Command="{Binding SetPasswordCommand}" />
                    <Button Content="Zurück zum Login"
                            Height="42"
                            Command="{Binding CancelOtpFlowCommand}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       Margin="0,12,0,0"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</Window>