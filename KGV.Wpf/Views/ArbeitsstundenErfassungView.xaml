<UserControl x:Class="KGV.Views.ArbeitsstundenErfassungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource KgvBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="ValidationTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource KgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="BorderBrush" Value="IndianRed" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValidationDatePickerStyle" TargetType="DatePicker">
            <Setter Property="BorderBrush" Value="{StaticResource KgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="BorderBrush" Value="IndianRed" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Border Padding="18"
                Background="{StaticResource KgvSurfaceBrush}"
                BorderBrush="{StaticResource KgvBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                MaxWidth="720"
                HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding Description}" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock Margin="0,12,0,0">
                    <Run Text="Mitglied: " />
                    <Run Text="{Binding CurrentMemberText}" FontWeight="SemiBold" />
                </TextBlock>

                <TextBlock Text="{Binding ValidationMessage}"
                           Margin="0,14,0,0"
                           Foreground="IndianRed"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,14,0,0"
                           Foreground="DarkSlateBlue"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Datum *" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <DatePicker Grid.Row="0"
                                Grid.Column="1"
                                x:Name="DatumPicker"
                                Style="{StaticResource ValidationDatePickerStyle}"
                                Tag="{Binding IsDatumInvalid}"
                                SelectedDate="{Binding Datum, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Stunden *" VerticalAlignment="Center" Margin="0,12,12,0" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             x:Name="StundenTextBox"
                             Margin="0,12,0,0"
                             Style="{StaticResource ValidationTextBoxStyle}"
                             Tag="{Binding IsStundenInvalid}"
                             Text="{Binding StundenText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Art der Arbeit *" VerticalAlignment="Top" Margin="0,12,12,0" />
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             x:Name="ArtDerArbeitTextBox"
                             Margin="0,12,0,0"
                             Height="120"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             Style="{StaticResource ValidationTextBoxStyle}"
                             Tag="{Binding IsArtDerArbeitInvalid}"
                             Text="{Binding ArtDerArbeit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Border Margin="0,18,0,0" Padding="12" Background="{StaticResource KgvBackgroundBrush}" CornerRadius="12">
                    <TextBlock Text="Neue Einträge werden in diesem Userflow immer mit `freigegeben = false` gespeichert und erscheinen danach im offenen Freigabeindikator für Admin/Vorstand." TextWrapping="Wrap" />
                </Border>

                <DockPanel Margin="0,18,0,0" LastChildFill="False">
                    <Button Content="Abbrechen"
                            Width="110"
                            DockPanel.Dock="Right"
                            Margin="0,0,10,0"
                            Command="{Binding AbbrechenCommand}" />
                    <Button Content="Speichern"
                            Width="110"
                            DockPanel.Dock="Right"
                            Command="{Binding SpeichernCommand}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
