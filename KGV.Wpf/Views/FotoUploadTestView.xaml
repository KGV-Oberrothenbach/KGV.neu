<UserControl x:Class="KGV.Views.FotoUploadTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel MaxWidth="860">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,18" />

                <Border Padding="16"
                        Background="{StaticResource KgvSurfaceBrush}"
                        BorderBrush="{StaticResource KgvBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="Bild" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Bild wÃ¤hlen" Width="140" Command="{Binding SelectImageCommand}" />
                            <TextBlock Text="{Binding SelectedFileName}" Margin="12,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Kind" FontWeight="SemiBold" />
                                <ComboBox Margin="0,8,0,0"
                                          ItemsSource="{Binding KindOptions}"
                                          SelectedItem="{Binding SelectedKind, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Medium" FontWeight="SemiBold" />
                                <ComboBox Margin="0,8,0,0"
                                          ItemsSource="{Binding MediumOptions}"
                                          SelectedItem="{Binding SelectedMedium, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,12,0">
                                <TextBlock Text="Anlage" FontWeight="SemiBold" />
                                <TextBox Margin="0,8,0,0"
                                         Text="{Binding Anlage, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,16,0,0">
                                <TextBlock Text="Garten" FontWeight="SemiBold" />
                                <TextBox Margin="0,8,0,0"
                                         Text="{Binding Garten, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,16,12,0">
                                <TextBlock Text="ZÃ¤hlernummer (optional)" FontWeight="SemiBold" />
                                <TextBox Margin="0,8,0,0"
                                         Text="{Binding Zaehlernummer, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,16,0,0">
                                <TextBlock Text="Datum" FontWeight="SemiBold" />
                                <DatePicker Margin="0,8,0,0"
                                            SelectedDate="{Binding Datum, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,16,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="DarkSlateBlue"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button Content="Upload testen"
                                Width="160"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding UploadCommand}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="16"
                        Background="{StaticResource KgvBackgroundBrush}"
                        CornerRadius="16"
                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Diagnose" FontWeight="SemiBold" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="HTTP-Status:" FontWeight="SemiBold" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HttpStatusDisplay}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Text="file_id:" FontWeight="SemiBold" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileId}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="2" Text="file_name:" FontWeight="SemiBold" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResultFileName}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="3" Text="relative_path:" FontWeight="SemiBold" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RelativePath}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="4" Text="Exception:" FontWeight="SemiBold" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ExceptionMessage}" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="Rohantwort" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBox Margin="0,8,0,0"
                                 Text="{Binding RawResponseBody, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="180" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

